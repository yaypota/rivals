local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/refs/heads/main/Library.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/refs/heads/main/addons/SaveManager.lua"))()
local ThemeManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/refs/heads/main/addons/ThemeManager.lua"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local showNotifications = true
local walkSpeedValue = 16
local jumpPowerValue = 50
local infinityJumpEnabled = false
local teleportEnabled = false
local teleportLoop = nil
local selectedPlayer = "No Players"
local teleportMode = "Behind"
local playerDropdown = nil
local playerListReady = false

local voidX = 0
local voidY = -50
local voidZ = 0
local voidPosition = nil
local voidPositionConnection = nil
local voidTeleportEnabled = false
local voidSpamEnabled = false
local voidSpamConnection = nil
local voidHideTime = 0.1
local voidAttackTime = 0.1
local voidSpamPosition = nil
local voidSpamAttackOffset = Vector3.new(0, -100, 0)
local isHiding = true
local lastSwitch = 0
local voidTeleportActive = false
local voidSpamActive = false

local selectedConfig = "No Configs"
local configDropdown = nil
local configReady = false

local Window = Library:CreateWindow({
    Title = "Rivals Utility",
    Center = false,
    AutoShow = true,
    TabWidth = 160,
    Position = UDim2.new(0, 0, 0, 0)
})

local MainTab = Window:AddTab("Main")
local PlayerTab = Window:AddTab("Player")
local SettingsTab = Window:AddTab("Settings")

local MainLeftGroup = MainTab:AddLeftGroupbox("Teleport Features")
local MainRightGroup = MainTab:AddRightGroupbox("Void Features")
local PlayerLeftGroup = PlayerTab:AddLeftGroupbox("Movement")
local PlayerRightGroup = PlayerTab:AddRightGroupbox("Jump")
local SettingsGroup = SettingsTab:AddLeftGroupbox("Configuration")
local UISettingsGroup = SettingsTab:AddRightGroupbox("UI Settings")

local function Notify(title, text, duration)
    if not showNotifications then return end
    duration = duration or 2
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = title,
        Text = text,
        Duration = duration
    })
end

local function GetPlayerList()
    local list = {}
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer then
            table.insert(list, v.Name)
        end
    end
    if #list == 0 then
        table.insert(list, "No Players")
    end
    return list
end

local function SafeTeleport(CFrameValue)
    if not LocalPlayer.Character then return false end
    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    hrp.CFrame = CFrameValue
    return true
end

local function ApplyMovementSettings()
    if LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = walkSpeedValue
            humanoid.JumpPower = jumpPowerValue
        end
    end
end

local function UpdatePlayerList()
    if playerDropdown and playerListReady then
        local newList = GetPlayerList()
        playerDropdown:SetValues(newList)
        if not table.find(newList, selectedPlayer) then
            selectedPlayer = newList[1] or "No Players"
            playerDropdown:SetValue(selectedPlayer)
        end
    end
end

local function UpdateConfigList()
    if configDropdown and configReady then
        local configList = {}
        for _, v in ipairs(SaveManager:GetConfigList()) do
            table.insert(configList, v)
        end
        if #configList == 0 then
            table.insert(configList, "No Configs")
        end
        configDropdown:SetValues(configList)
        if not table.find(configList, selectedConfig) then
            selectedConfig = configList[1] or "No Configs"
            configDropdown:SetValue(selectedConfig)
        end
    end
end

local function SetupMainTab()
    playerDropdown = MainLeftGroup:AddDropdown("Target Player", {
        Text = "Target Player",
        Description = "Select player to teleport to",
        Values = GetPlayerList(),
        Default = "No Players",
        Callback = function(value)
            selectedPlayer = value
        end
    })
    playerListReady = true

    MainLeftGroup:AddDropdown("Teleport Mode", {
        Text = "Teleport Mode",
        Description = "Choose teleport position",
        Values = {"Behind", "Above", "Underground"},
        Default = "Behind",
        Callback = function(value)
            teleportMode = value
        end
    })

    MainLeftGroup:AddToggle("Player Teleport", {
        Text = "Player Teleport",
        Description = "Teleports to selected player continuously",
        Default = false,
        Callback = function(state)
            teleportEnabled = state
            if teleportEnabled then
                if selectedPlayer == "No Players" then
                    Notify("Error", "No players available", 2)
                    return
                end
                teleportLoop = RunService.Heartbeat:Connect(function()
                    if selectedPlayer == "No Players" then return end
                    local target = nil
                    for _, v in pairs(Players:GetPlayers()) do
                        if v.Name == selectedPlayer and v ~= LocalPlayer then
                            target = v
                            break
                        end
                    end
                    if not target then return end
                    if not target.Character then return end
                    local targetHrp = target.Character:FindFirstChild("HumanoidRootPart")
                    if not targetHrp then return end
                    if not LocalPlayer.Character then return end
                    local myHrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if not myHrp then return end
                    local targetPos = targetHrp.Position
                    local teleportPos = targetPos
                    if teleportMode == "Behind" then
                        teleportPos = targetPos - targetHrp.CFrame.LookVector * 3
                    elseif teleportMode == "Above" then
                        teleportPos = targetPos + Vector3.new(0, 5, 0)
                    elseif teleportMode == "Underground" then
                        teleportPos = targetPos + Vector3.new(0, -3, 0)
                    end
                    SafeTeleport(CFrame.new(teleportPos))
                end)
                Notify("Player Teleport", "Enabled", 1)
            else
                if teleportLoop then
                    teleportLoop:Disconnect()
                    teleportLoop = nil
                end
                Notify("Player Teleport", "Disabled", 1)
            end
        end
    })

    MainLeftGroup:AddButton({
        Text = "Refresh Players",
        Description = "Updates player list",
        Func = function()
            UpdatePlayerList()
            Notify("Players", "List updated", 1)
        end
    })
end

local function SetupVoidFeatures()
    MainRightGroup:AddSlider("Void X", {
        Text = "Void X",
        Description = "X axis position",
        Default = 0,
        Min = -100000,
        Max = 100000,
        Rounding = 1,
        Callback = function(value)
            voidX = value
        end
    })

    MainRightGroup:AddSlider("Void Y", {
        Text = "Void Y",
        Description = "Y axis position",
        Default = -50,
        Min = -100000,
        Max = 100000,
        Rounding = 1,
        Callback = function(value)
            voidY = value
        end
    })

    MainRightGroup:AddSlider("Void Z", {
        Text = "Void Z",
        Description = "Z axis position",
        Default = 0,
        Min = -100000,
        Max = 100000,
        Rounding = 1,
        Callback = function(value)
            voidZ = value
        end
    })

    MainRightGroup:AddButton({
        Text = "Set Void Position",
        Description = "Sets void teleport position",
        Func = function()
            voidPosition = CFrame.new(voidX, voidY, voidZ)
            Notify("Void Position", "Set to X:"..voidX.." Y:"..voidY.." Z:"..voidZ, 2)
        end
    })

    MainRightGroup:AddToggle("Void Teleport", {
        Text = "Void Teleport",
        Description = "Teleports to position when in void",
        Default = false,
        Callback = function(state)
            if state and voidSpamActive then
                Notify("Error", "Disable Void Spam first", 2)
                return
            end
            voidTeleportEnabled = state
            voidTeleportActive = state
            if voidTeleportEnabled then
                if not voidPosition then
                    voidPosition = CFrame.new(voidX, voidY, voidZ)
                    Notify("Void Teleport", "Using default position", 2)
                end
                voidPositionConnection = RunService.Heartbeat:Connect(function()
                    if not voidTeleportActive then return end
                    if not LocalPlayer.Character then return end
                    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end
                    if hrp.Position.Y < -50 then
                        SafeTeleport(voidPosition)
                    end
                end)
                Notify("Void Teleport", "Enabled", 1)
            else
                voidTeleportActive = false
                if voidPositionConnection then
                    voidPositionConnection:Disconnect()
                    voidPositionConnection = nil
                end
                Notify("Void Teleport", "Disabled", 1)
            end
        end
    })

    MainRightGroup:AddSlider("Void Hide Time", {
        Text = "Void Hide Time",
        Description = "Time to hide (seconds)",
        Default = 0.1,
        Min = 0.01,
        Max = 5,
        Rounding = 2,
        Callback = function(value)
            voidHideTime = value
        end
    })

    MainRightGroup:AddSlider("Void Attack Time", {
        Text = "Void Attack Time",
        Description = "Time to attack (seconds)",
        Default = 0.1,
        Min = 0.01,
        Max = 5,
        Rounding = 2,
        Callback = function(value)
            voidAttackTime = value
        end
    })

    MainRightGroup:AddSlider("Void Attack X", {
        Text = "Void Attack X",
        Description = "Attack position X offset",
        Default = 0,
        Min = -500,
        Max = 500,
        Rounding = 1,
        Callback = function(value)
            voidSpamAttackOffset = Vector3.new(value, voidSpamAttackOffset.Y, voidSpamAttackOffset.Z)
        end
    })

    MainRightGroup:AddSlider("Void Attack Y", {
        Text = "Void Attack Y",
        Description = "Attack position Y offset",
        Default = -100,
        Min = -500,
        Max = 500,
        Rounding = 1,
        Callback = function(value)
            voidSpamAttackOffset = Vector3.new(voidSpamAttackOffset.X, value, voidSpamAttackOffset.Z)
        end
    })

    MainRightGroup:AddSlider("Void Attack Z", {
        Text = "Void Attack Z",
        Description = "Attack position Z offset",
        Default = 0,
        Min = -500,
        Max = 500,
        Rounding = 1,
        Callback = function(value)
            voidSpamAttackOffset = Vector3.new(voidSpamAttackOffset.X, voidSpamAttackOffset.Y, value)
        end
    })

    MainRightGroup:AddButton({
        Text = "Set Void Spam Position",
        Description = "Sets position for void spam",
        Func = function()
            if LocalPlayer.Character then
                local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    voidSpamPosition = hrp.Position
                    Notify("Void Spam", "Position set", 1)
                end
            end
        end
    })

    MainRightGroup:AddToggle("Void Spam", {
        Text = "Void Spam",
        Description = "Spams between void and position",
        Default = false,
        Callback = function(state)
            if state and voidTeleportActive then
                Notify("Error", "Disable Void Teleport first", 2)
                return
            end
            voidSpamEnabled = state
            voidSpamActive = state
            if voidSpamEnabled then
                if not voidSpamPosition then
                    Notify("Error", "Set position first", 2)
                    return
                end
                isHiding = true
                lastSwitch = tick()
                voidSpamConnection = RunService.Heartbeat:Connect(function()
                    if not voidSpamActive then return end
                    if not LocalPlayer.Character then return end
                    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end
                    local currentTime = tick()
                    if hrp.Position.Y < -50 then
                        if isHiding then
                            if currentTime - lastSwitch >= voidHideTime then
                                isHiding = false
                                lastSwitch = currentTime
                                SafeTeleport(CFrame.new(voidSpamPosition))
                            end
                        else
                            if currentTime - lastSwitch >= voidAttackTime then
                                isHiding = true
                                lastSwitch = currentTime
                                local attackPos = voidSpamPosition + voidSpamAttackOffset
                                SafeTeleport(CFrame.new(attackPos))
                            end
                        end
                    end
                end)
                Notify("Void Spam", "Enabled", 1)
            else
                voidSpamActive = false
                if voidSpamConnection then
                    voidSpamConnection:Disconnect()
                    voidSpamConnection = nil
                end
                Notify("Void Spam", "Disabled", 1)
            end
        end
    })
end

local function SetupPlayerTab()
    PlayerLeftGroup:AddSlider("Walk Speed", {
        Text = "Walk Speed",
        Description = "Changes walk speed (0 = no movement)",
        Default = 16,
        Min = 0,
        Max = 100,
        Rounding = 1,
        Callback = function(value)
            walkSpeedValue = value
            ApplyMovementSettings()
        end
    })

    PlayerLeftGroup:AddSlider("Jump Power", {
        Text = "Jump Power",
        Description = "Changes jump power (0 = no jump)",
        Default = 50,
        Min = 0,
        Max = 300,
        Rounding = 1,
        Callback = function(value)
            jumpPowerValue = value
            ApplyMovementSettings()
        end
    })

    PlayerLeftGroup:AddToggle("Infinity Jump", {
        Text = "Infinity Jump",
        Description = "Allows unlimited jumps (hold space)",
        Default = false,
        Callback = function(state)
            infinityJumpEnabled = state
            if infinityJumpEnabled then
                if LocalPlayer.Character then
                    local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
                    if humanoid then
                        humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                    end
