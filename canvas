                Notify("Infinity Jump", "Hold Space to jump", 2)
            else
                Notify("Infinity Jump", "Disabled", 1)
            end
        end
    })

    PlayerRightGroup:AddButton({
        Text = "Reset Walk Speed",
        Description = "Resets to default walk speed",
        Func = function()
            walkSpeedValue = 16
            ApplyMovementSettings()
            Notify("Walk Speed", "Reset to 16", 1)
        end
    })

    PlayerRightGroup:AddButton({
        Text = "Reset Jump Power",
        Description = "Resets to default jump power",
        Func = function()
            jumpPowerValue = 50
            ApplyMovementSettings()
            Notify("Jump Power", "Reset to 50", 1)
        end
    })
end

local function SetupSettingsTab()
    SettingsGroup:AddToggle("Show Notifications", {
        Text = "Show Notifications",
        Description = "Toggle notifications on/off",
        Default = true,
        Callback = function(state)
            showNotifications = state
        end
    })

    configDropdown = SettingsGroup:AddDropdown("Select Config", {
        Text = "Select Config",
        Description = "Choose a config",
        Values = function()
            local configList = {}
            for _, v in ipairs(SaveManager:GetConfigList()) do
                table.insert(configList, v)
            end
            if #configList == 0 then
                table.insert(configList, "No Configs")
            end
            return configList
        end,
        Default = "No Configs",
        Callback = function(value)
            selectedConfig = value
        end
    })
    configReady = true

    SettingsGroup:AddButton({
        Text = "Load Config",
        Description = "Loads selected config",
        Func = function()
            if selectedConfig and selectedConfig ~= "No Configs" then
                local success, err = pcall(function()
                    SaveManager:LoadConfig(selectedConfig)
                end)
                if success then
                    UpdateConfigList()
                    UpdatePlayerList()
                    ApplyMovementSettings()
                    Notify("Config", "Loaded: "..selectedConfig, 2)
                else
                    Notify("Error", "Failed to load config", 2)
                end
            else
                Notify("Error", "No config selected", 2)
            end
        end
    })

    SettingsGroup:AddButton({
        Text = "Save Config",
        Description = "Saves current settings",
        Func = function()
            local success, err = pcall(function()
                SaveManager:Save()
            end)
            if success then
                UpdateConfigList()
                Notify("Config", "Saved successfully", 2)
            else
                Notify("Error", "Failed to save config", 2)
            end
        end
    })

    SettingsGroup:AddButton({
        Text = "Delete Config",
        Description = "Deletes selected config",
        Func = function()
            if selectedConfig and selectedConfig ~= "No Configs" then
                local success, err = pcall(function()
                    SaveManager:DeleteConfig(selectedConfig)
                end)
                if success then
                    UpdateConfigList()
                    Notify("Config", "Deleted: "..selectedConfig, 2)
                else
                    Notify("Error", "Failed to delete config", 2)
                end
            else
                Notify("Error", "No config selected", 2)
            end
        end
    })

    SettingsGroup:AddButton({
        Text = "Reset All Settings",
        Description = "Resets all settings",
        Func = function()
            local success, err = pcall(function()
                SaveManager:Reset()
            end)
            if success then
                UpdateConfigList()
                Notify("Settings", "Reset to default", 2)
            else
                Notify("Error", "Failed to reset settings", 2)
            end
        end
    })

    UISettingsGroup:AddDropdown("UI Theme", {
        Text = "UI Theme",
        Description = "Changes UI theme",
        Values = {"Dark", "Light", "Blue", "Red", "Purple", "Green", "Orange", "Pink"},
        Default = "Dark",
        Callback = function(value)
            local success, err = pcall(function()
                ThemeManager:SetTheme(value)
            end)
            if success then
                Notify("Theme", "Changed to: "..value, 1)
            else
                Notify("Error", "Theme change failed", 1)
            end
        end
    })

    UISettingsGroup:AddToggle("Watermark", {
        Text = "Show Watermark",
        Description = "Shows watermark",
        Default = true,
        Callback = function(state)
            pcall(function()
                Library:SetWatermarkVisibility(state)
            end)
        end
    })

    UISettingsGroup:AddSlider("Watermark Opacity", {
        Text = "Watermark Opacity",
        Description = "Changes transparency",
        Default = 1,
        Min = 0,
        Max = 1,
        Rounding = 2,
        Callback = function(value)
            pcall(function()
                Library:SetWatermarkTransparency(value)
            end)
        end
    })
end

local function onCharacterAdded()
    task.wait(0.1)
    ApplyMovementSettings()
    if infinityJumpEnabled then
        if LocalPlayer.Character then
            local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
            if humanoid then
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            end
        end
    end
end

LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

if LocalPlayer.Character then
    task.wait(0.1)
    ApplyMovementSettings()
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Space and infinityJumpEnabled then
        if LocalPlayer.Character then
            local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)

Players.PlayerAdded:Connect(function()
    UpdatePlayerList()
end)

Players.PlayerRemoving:Connect(function()
    UpdatePlayerList()
end)

pcall(function()
    Library:SetWatermarkVisibility(true)
    Library:SetWatermark("Rivals Utility | Loaded")
end)

pcall(function()
    SaveManager:SetLibrary(Library)
    ThemeManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({})
    ThemeManager:SetFolder("RivalsUtility")
    SaveManager:SetFolder("RivalsUtility")
end)

task.wait(0.1)
SetupMainTab()
Notify("Loading", "Main tab loaded", 1)

task.wait(0.1)
SetupVoidFeatures()
Notify("Loading", "Void features loaded", 1)

task.wait(0.1)
SetupPlayerTab()
Notify("Loading", "Player tab loaded", 1)

task.wait(0.1)
SetupSettingsTab()
Notify("Loading", "Settings tab loaded", 1)

task.wait(0.2)
pcall(function()
    SaveManager:Load()
    task.wait(0.1)
    UpdateConfigList()
    UpdatePlayerList()
    ApplyMovementSettings()
end)

Notify("Rivals Utility", "Fully loaded!", 2)
