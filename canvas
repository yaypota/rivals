local teleportEnabled = false
local teleportLoop = nil
local selectedPlayer = nil
local teleportMode = "Behind"

MainLeftGroup:AddDropdown("Target Player", {
    Text = "Target Player",
    Description = "Select player to teleport to",
    Values = function()
        local players = {}
        for _, v in ipairs(game.Players:GetPlayers()) do
            if v ~= game.Players.LocalPlayer then
                table.insert(players, v.Name)
            end
        end
        return players
    end,
    Default = "",
    Callback = function(value)
        selectedPlayer = value
    end
})

MainLeftGroup:AddDropdown("Teleport Mode", {
    Text = "Teleport Mode",
    Description = "Choose teleport position",
    Values = {"Behind", "Above", "Underground"},
    Default = "Behind",
    Callback = function(value)
        teleportMode = value
    end
})

MainLeftGroup:AddToggle("Player Teleport", {
    Text = "Player Teleport",
    Description = "Teleports to selected player continuously",
    Default = false,
    Callback = function(state)
        teleportEnabled = state
        local player = game.Players.LocalPlayer
        if teleportEnabled then
            teleportLoop = game:GetService("RunService").Heartbeat:Connect(function()
                if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
                local target = nil
                for _, v in ipairs(game.Players:GetPlayers()) do
                    if v.Name == selectedPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                        target = v
                        break
                    end
                end
                if not target then return end
                local targetPos = target.Character.HumanoidRootPart.Position
                local teleportPos = targetPos
                if teleportMode == "Behind" then
                    teleportPos = targetPos - target.Character.HumanoidRootPart.CFrame.LookVector * 3
                elseif teleportMode == "Above" then
                    teleportPos = targetPos + Vector3.new(0, 5, 0)
                elseif teleportMode == "Underground" then
                    teleportPos = targetPos + Vector3.new(0, -3, 0)
                end
                player.Character.HumanoidRootPart.CFrame = CFrame.new(teleportPos)
            end)
        else
            if teleportLoop then
                teleportLoop:Disconnect()
                teleportLoop = nil
            end
        end
    end
})

local voidX = 0
local voidY = 0
local voidZ = 0
local voidPosition = nil
local voidPositionConnection = nil

MainRightGroup:AddSlider("Void X", {
    Text = "Void X",
    Description = "X axis position for void teleport",
    Default = 0,
    Min = 0,
    Max = 100000,
    Rounding = 1,
    Callback = function(value)
        voidX = value
    end
})

MainRightGroup:AddSlider("Void Y", {
    Text = "Void Y",
    Description = "Y axis position for void teleport",
    Default = 0,
    Min = 0,
    Max = 100000,
    Rounding = 1,
    Callback = function(value)
        voidY = value
    end
})

MainRightGroup:AddSlider("Void Z", {
    Text = "Void Z",
    Description = "Z axis position for void teleport",
    Default = 0,
    Min = 0,
    Max = 100000,
    Rounding = 1,
    Callback = function(value)
        voidZ = value
    end
})

MainRightGroup:AddButton({
    Text = "Set Void Position",
    Description = "Sets void teleport position from XYZ values",
    Func = function()
        voidPosition = CFrame.new(voidX, voidY, voidZ)
    end
})

MainRightGroup:AddToggle("Void Teleport", {
    Text = "Void Teleport",
    Description = "Teleports to XYZ position when falling into void",
    Default = false,
    Callback = function(state)
        local player = game.Players.LocalPlayer
        if state then
            if not voidPosition then return end
            voidPositionConnection = game:GetService("RunService").Heartbeat:Connect(function()
                if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
                local humanoidRootPart = player.Character.HumanoidRootPart
                if humanoidRootPart.Position.Y < -50 then
                    humanoidRootPart.CFrame = voidPosition
                end
            end)
        else
            if voidPositionConnection then
                voidPositionConnection:Disconnect()
                voidPositionConnection = nil
            end
        end
    end
})

local voidSpamEnabled = false
local voidSpamConnection = nil
local voidHideTime = 0.1
local voidAttackTime = 0.1
local voidSpamPosition = nil
local isHiding = true
local lastSwitch = 0

MainRightGroup:AddSlider("Void Hide Time", {
    Text = "Void Hide Time",
    Description = "Time to stay hidden in void (seconds)",
    Default = 0.1,
    Min = 0.01,
    Max = 5,
    Rounding = 2,
    Callback = function(value)
        voidHideTime = value
    end
})

MainRightGroup:AddSlider("Void Attack Time", {
    Text = "Void Attack Time",
    Description = "Time to attack (seconds)",
    Default = 0.1,
    Min = 0.01,
    Max = 5,
    Rounding = 2,
    Callback = function(value)
        voidAttackTime = value
    end
})

MainRightGroup:AddButton({
    Text = "Set Void Spam Position",
    Description = "Sets position for void spam",
    Func = function()
        local player = game.Players.LocalPlayer
        if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            voidSpamPosition = player.Character.HumanoidRootPart.Position
        end
    end
})

MainRightGroup:AddToggle("Void Spam", {
    Text = "Void Spam",
    Description = "Spams between void and attack position",
    Default = false,
    Callback = function(state)
        voidSpamEnabled = state
        local player = game.Players.LocalPlayer
        if voidSpamEnabled then
            if not voidSpamPosition then return end
            isHiding = true
            lastSwitch = tick()
            voidSpamConnection = game:GetService("RunService").Heartbeat:Connect(function()
                if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
                local humanoidRootPart = player.Character.HumanoidRootPart
                local currentTime = tick()
                if humanoidRootPart.Position.Y < -50 then
                    if isHiding then
                        if currentTime - lastSwitch >= voidHideTime then
                            isHiding = false
                            lastSwitch = currentTime
                            humanoidRootPart.CFrame = CFrame.new(voidSpamPosition)
                        end
                    else
                        if currentTime - lastSwitch >= voidAttackTime then
                            isHiding = true
                            lastSwitch = currentTime
                            humanoidRootPart.CFrame = CFrame.new(voidSpamPosition + Vector3.new(0, -100, 0))
                        end
                    end
                end
            end)
        else
            if voidSpamConnection then
                voidSpamConnection:Disconnect()
                voidSpamConnection = nil
            end
        end
    end
})

