local function GetRageTargets()
    local targets = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local distance = (character.HumanoidRootPart.Position - hrp.Position).Magnitude
                
                local priorityScore = 0
                if ragebotPriority == "Distance" then
                    priorityScore = 1000 - distance
                elseif ragebotPriority == "Health" then
                    local humanoid = player.Character:FindFirstChild("Humanoid")
                    if humanoid then
                        priorityScore = humanoid.Health / humanoid.MaxHealth * 100
                    end
                elseif ragebotPriority == "Visibility" then
                    local screenPos, onScreen = Camera:WorldToScreenPoint(hrp.Position)
                    if onScreen then
                        priorityScore = 100
                    end
                end
                
                table.insert(targets, {
                    player = player,
                    hrp = hrp,
                    distance = distance,
                    priority = priorityScore
                })
            end
        end
    end
    
    table.sort(targets, function(a, b)
        return a.priority > b.priority
    end)
    
    return targets
end

local function FireRageShot(targetPos)
    local character = LocalPlayer.Character
    if not character then return end
    
    local remote = ReplicatedStorage:FindFirstChild("ShootEvent") or ReplicatedStorage:FindFirstChild("Attack")
    if remote then
        remote:FireServer(targetPos)
    end
    
    if ragebotHumanization then
        local randomOffset = Vector3.new(
            math.random(-5, 5) / 10,
            math.random(-5, 5) / 10,
            math.random(-5, 5) / 10
        )
        remote:FireServer(targetPos + randomOffset)
    end
end

local function PerformWallbang(target)
    local character = LocalPlayer.Character
    if not character then return end
    
    local remote = ReplicatedStorage:FindFirstChild("WallbangEvent")
    if remote then
        remote:FireServer(target.player)
    end
end

local function AutoShoot(target)
    local character = LocalPlayer.Character
    if not character then return end
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    if target.distance < 100 then
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
        end
    end
end

local function Triggerbot(target)
    local character = LocalPlayer.Character
    if not character then return end
    
    local screenPos, onScreen = Camera:WorldToScreenPoint(target.hrp.Position)
    if onScreen then
        local distance = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
        if distance < 100 then
            wait(ragebotTriggerDelay)
            FireRageShot(target.hrp.Position)
        end
    end
end

local function MultiTargetAttack(target)
    if target and target.hrp then
        FireRageShot(target.hrp.Position + Vector3.new(math.random(-5, 5), math.random(-5, 5), math.random(-5, 5)))
    end
end

local function Ragebot()
    if not ragebotEnabled then return end
    
    local targets = GetRageTargets()
    if #targets == 0 then return end
    
    local bestTarget = nil
    local bestScore = -math.huge
    
    for _, target in ipairs(targets) do
        if target.distance <= ragebotFOV then
            local score = target.priority
            if ragebotHitChance and math.random(1, 100) <= ragebotHitChance then
                score = score * 1.5
            end
            if score > bestScore then
                bestScore = score
                bestTarget = target
            end
        end
    end
    
    if bestTarget then
        if ragebotPrediction then
            local velocity = bestTarget.hrp.Velocity
            local predictedPos = bestTarget.hrp.Position + (velocity * ragebotPredictionMultiplier)
            FireRageShot(predictedPos)
        else
            FireRageShot(bestTarget.hrp.Position)
        end
        
        if ragebotWallbang then
            PerformWallbang(bestTarget)
        end
        
        if ragebotAutoShoot then
            AutoShoot(bestTarget)
        end
        
        if ragebotTriggerbot then
            Triggerbot(bestTarget)
        end
        
        if ragebotMultiTarget and #targets > 1 then
            for i = 2, math.min(3, #targets) do
                MultiTargetAttack(targets[i])
            end
        end
    end
end

