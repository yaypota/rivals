local function DetectProjectiles()
    local projectiles = {}
    local character = LocalPlayer.Character
    if not character then return projectiles end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return projectiles end
    
    local playerPos = hrp.Position
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local isProjectile = false
            local name = obj.Name:lower()
            
            if name:find("projectile") or 
               name:find("bullet") or 
               name:find("missile") or 
               name:find("rocket") or 
               name:find("ball") or
               name:find("orb") or
               name:find("shot") or
               name:find("beam") or
               name:find("laser") or
               name:find("void") then
                isProjectile = true
            end
            
            if not isProjectile and obj:IsA("BasePart") and obj.Velocity.Magnitude > 10 then
                isProjectile = true
            end
            
            if isProjectile and obj.Parent and not obj.Parent:IsA("Player") then
                local distance = (playerPos - obj.Position).Magnitude
                if distance < dodgeRadius then
                    table.insert(projectiles, {
                        object = obj,
                        position = obj.Position,
                        velocity = obj.Velocity,
                        distance = distance
                    })
                end
            end
        end
    end
    
    return projectiles
end

local function PredictProjectile(projectile)
    if not projectile then return nil end
    
    local character = LocalPlayer.Character
    if not character then return nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local playerPos = hrp.Position
    local projPos = projectile.position
    local projVel = projectile.velocity
    
    if projVel.Magnitude < 1 then return nil end
    
    local predTime = dodgePredictionTime
    local predictedPos = projPos + (projVel * predTime)
    local dirToPlayer = (playerPos - projPos).Unit
    local projDir = projVel.Unit
    local angle = math.acos(math.clamp(dirToPlayer:Dot(projDir), -1, 1))
    local relativeVelocity = projVel - Vector3.new(0, 0, 0)
    local timeToImpact = (playerPos - projPos).Magnitude / relativeVelocity.Magnitude
    
    local isCritical = false
    if timeToImpact < 1 and angle < math.rad(45) then
        isCritical = true
    end
    
    return {
        predictedPos = predictedPos,
        timeToImpact = timeToImpact,
        isCritical = isCritical,
        impactPoint = playerPos + (projVel.Unit * (playerPos - projPos).Magnitude)
    }
end

local function GetDodgeDirection(projectile)
    local character = LocalPlayer.Character
    if not character then return nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local playerPos = hrp.Position
    local projPos = projectile.position
    local projVel = projectile.velocity
    
    local directions = {}
    
    if dodgeDirection == "Random" then
        local angle = math.random(0, 360)
        local rad = math.rad(angle)
        local dir = Vector3.new(math.cos(rad), 0, math.sin(rad))
        table.insert(directions, dir * dodgeDistance)
        
    elseif dodgeDirection == "Left" then
        local leftDir = -Camera.CFrame.RightVector
        table.insert(directions, leftDir * dodgeDistance)
        
    elseif dodgeDirection == "Right" then
        local rightDir = Camera.CFrame.RightVector
        table.insert(directions, rightDir * dodgeDistance)
        
    elseif dodgeDirection == "Back" then
        local backDir = -Camera.CFrame.LookVector
        table.insert(directions, backDir * dodgeDistance)
        
    elseif dodgeDirection == "Forward" then
        local forwardDir = Camera.CFrame.LookVector
        table.insert(directions, forwardDir * dodgeDistance)
    else
        local projDir = projVel.Unit
        local perpDir = Vector3.new(-projDir.Z, 0, projDir.X)
        if math.random(1, 2) == 1 then
            perpDir = -perpDir
        end
        table.insert(directions, perpDir * dodgeDistance)
        table.insert(directions, -perpDir * dodgeDistance)
    end
    
    return directions
end

local function PerformDodge(direction)
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local currentPos = hrp.Position
    local targetPos = currentPos + direction
    
    local tweenInfo = TweenInfo.new(
        dodgeSmoothness,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )
    
    local tween = TweenService:Create(hrp, tweenInfo, {Position = targetPos})
    tween:Play()
    
    dodgeLastDodge = tick()
end

local function Dodger()
    if not dodgeEnabled then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if tick() - dodgeLastDodge < dodgeCooldown then
        return
    end
    
    local projectiles = DetectProjectiles()
    if #projectiles == 0 then return end
    
    local shouldDodge = false
    local dodgeDir = nil
    local dangerLevel = 0
    
    for _, proj in ipairs(projectiles) do
        local prediction = PredictProjectile(proj)
        if prediction then
            if prediction.isCritical then
                dangerLevel = dangerLevel + 2
            else
                dangerLevel = dangerLevel + 1
            end
            
            if dodgeMode == "Auto" then
                shouldDodge = true
            elseif dodgeMode == "Smart" then
                if prediction.timeToImpact < 0.5 or prediction.isCritical then
                    shouldDodge = true
                end
            elseif dodgeMode == "Manual" then
                if UserInputService:IsKeyDown(Enum.KeyCode.X) then
                    shouldDodge = true
                end
            end
            
            if shouldDodge then
                local directions = GetDodgeDirection(proj)
                if directions and #directions > 0 then
                    local bestDir = directions[1]
                    local bestScore = -math.huge
                    
                    for _, dir in ipairs(directions) do
                        local targetPos = hrp.Position + dir
                        local score = 0
                        
                        for _, otherProj in ipairs(projectiles) do
                            local distToOther = (targetPos - otherProj.position).Magnitude
                            if distToOther < 5 then
                                score = score - 10
                            else
                                score = score + (distToOther / dodgeRadius) * 5
                            end
                        end
                        
                        local raycastParams = RaycastParams.new()
                        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
                        raycastParams.FilterDescendantsInstances = {character}
                        
                        local ray = Ray.new(hrp.Position, dir * dodgeDistance)
                        local hit = workspace:Raycast(ray.Origin, ray.Direction, raycastParams)
                        if hit then
                            score = score - 20
                        end
                        
                        if score > bestScore then
                            bestScore = score
                            bestDir = dir
                        end
                    end
                    
                    dodgeDir = bestDir
                end
                break
            end
        end
    end
    
    if dodgeOnlyCritical and dangerLevel < 2 then
        return
    end
    
    if dodgeDir and shouldDodge then
        PerformDodge(dodgeDir)
    end
end

local function VisualizeDodge()
    if not dodgeVisualize then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    for _, proj in ipairs(DetectProjectiles()) do
        local prediction = PredictProjectile(proj)
        if prediction and prediction.isCritical then
            local highlight = Instance.new("Highlight")
            highlight.Parent = proj.object
            highlight.FillColor = Color3.fromRGB(255, 0, 0)
            highlight.FillTransparency = 0.5
            highlight.OutlineColor = Color3.fromRGB(255, 255, 0)
            highlight.OutlineTransparency = 0.3
            game:GetService("Debris"):AddItem(highlight, 0.5)
        end
    end
    
    local circle = Drawing.new("Circle")
    circle.Radius = dodgeRadius
    circle.Thickness = 1
    circle.Color = Color3.fromRGB(0, 255, 255)
    circle.Filled = false
    circle.Transparency = 0.3
    circle.Visible = true
    
    local screenPos, onScreen = Camera:WorldToScreenPoint(hrp.Position)
    if onScreen then
        circle.Position = Vector2.new(screenPos.X, screenPos.Y)
    end
    
    RunService.RenderStepped:Connect(function()
        if dodgeVisualize and dodgeEnabled then
            local newPos, newOnScreen = Camera:WorldToScreenPoint(hrp.Position)
            if newOnScreen then
                circle.Position = Vector2.new(newPos.X, newPos.Y)
            end
            circle.Visible = true
        else
            circle.Visible = false
        end
    end)
end

local function GetRandomTarget(targets)
    if #targets == 0 then return nil end
    return targets[math.random(1, #targets)]
end

local function CastVoidSpell(target)
    if not target or not target.Character then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    
    local remote = ReplicatedStorage:FindFirstChild("VoidSpellEvent") or ReplicatedStorage:FindFirstChild("CastSpell")
    if remote then
        local targetPos = target.Character.HumanoidRootPart.Position
        remote:FireServer(targetPos, target)
        
        if voidSpamCooldownReduction then
            local cooldownRemote = ReplicatedStorage:FindFirstChild("CooldownReduction")
            if cooldownRemote then
                cooldownRemote:FireServer()
            end
        end
        
        if voidSpamEnergyBoost then
            local energyRemote = ReplicatedStorage:FindFirstChild("EnergyBoost")
            if energyRemote then
                energyRemote:FireServer()
            end
        end
    end
end

local function PerformAOEVoid(targets)
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local remote = ReplicatedStorage:FindFirstChild("VoidAOEEvent")
    if remote then
        local centerPos = hrp.Position
        for _, target in ipairs(targets) do
            if target.Character then
                local targetPos = target.Character.HumanoidRootPart.Position
                if (centerPos - targetPos).Magnitude <= voidSpamAOERadius then
                    remote:FireServer(targetPos, target, voidSpamAOERadius)
                end
            end
        end
    end
end

local function PerformSilentCast(targets)
    local remote = ReplicatedStorage:FindFirstChild("SilentCastEvent")
    if remote then
        for _, target in ipairs(targets) do
            if target.Character then
                remote:FireServer(target)
            end
        end
    end
end

local function VoidSpam()
    if not voidSpamEnabled then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local targets = {}
    if voidSpamAutoTarget or voidSpamTargetAll then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local distance = (hrp.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if distance <= voidSpamRange then
                    table.insert(targets, player)
                end
            end
        end
    end
    
    if voidSpamAOE then
        local aoeTargets = {}
        for _, target in ipairs(targets) do
            if target.Character then
                table.insert(aoeTargets, target)
            end
        end
        
        if #aoeTargets > 0 then
            PerformAOEVoid(aoeTargets)
        end
    end
    
    if voidSpamMultiCast then
        for i = 1, voidSpamCastCount do
            if voidSpamTargetAll then
                for _, target in ipairs(targets) do
                    CastVoidSpell(target)
                    if voidSpamRandomize then
                        wait(math.random(1, 10) / 100)
                    end
                end
            else
                local target = GetRandomTarget(targets)
                if target then
                    CastVoidSpell(target)
                end
            end
        end
    else
        if voidSpamTargetAll then
            for _, target in ipairs(targets) do
                CastVoidSpell(target)
            end
        else
            local target = GetRandomTarget(targets)
            if target then
                CastVoidSpell(target)
            end
        end
    end
    
    if voidSpamSilentCast then
        PerformSilentCast(targets)
    end
end

local function SetVoidSpamMode(mode)
    voidSpamMode = mode
    
    if mode == "Normal" then
        voidSpamDelay = 0.5
        voidSpamMultiCast = false
        voidSpamCastCount = 1
    elseif mode == "Rapid" then
        voidSpamDelay = 0.2
        voidSpamMultiCast = true
        voidSpamCastCount = 3
    elseif mode == "Hyper" then
        voidSpamDelay = 0.05
        voidSpamMultiCast = true
        voidSpamCastCount = 5
    elseif mode == "Ultimate" then
        voidSpamDelay = 0.01
        voidSpamMultiCast = true
        voidSpamCastCount = 10
        voidSpamAOE = true
        voidSpamAOERadius = 30
    end
end

