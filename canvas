local function GetCharacter()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil, nil end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return nil, nil, nil end
    return char, hrp, humanoid
end

local function GetRaycastParams(character)
    raycastParams.FilterDescendantsInstances = {character}
    return raycastParams
end

local function ApplyNoclip(character)
    if not noclipEnabled or not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

local function UpdateProjectileCache()
    for i = #projectileCache, 1, -1 do
        table.remove(projectileCache, i)
    end
    
    local char, hrp = GetCharacter()
    if not char or not hrp then return end
    local playerPos = hrp.Position
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent and not obj.Parent:IsA("Player") then
            local isProjectile = false
            
            if obj:IsA("Projectile") or obj:IsA("Bullet") then
                isProjectile = true
            elseif obj:GetAttribute("IsProjectile") then
                isProjectile = true
            else
                local name = obj.Name:lower()
                if name:find("projectile") or name:find("bullet") or name:find("missile") or 
                   name:find("rocket") or name:find("ball") or name:find("orb") or
                   name:find("shot") or name:find("beam") or name:find("laser") or name:find("void") then
                    isProjectile = true
                end
            end
            
            if not isProjectile and obj.Velocity and obj.Velocity.Magnitude > 10 then
                isProjectile = true
            end
            
            if isProjectile then
                local distance = (playerPos - obj.Position).Magnitude
                if distance < dodgeRadius then
                    table.insert(projectileCache, {
                        object = obj,
                        position = obj.Position,
                        velocity = obj.Velocity,
                        distance = distance
                    })
                end
            end
        end
    end
end

local function GetRageTargets()
    for i = #targetTable, 1, -1 do
        table.remove(targetTable, i)
    end
    
    local char, hrp = GetCharacter()
    if not char or not hrp then return targetTable end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local targetHrp = player.Character.HumanoidRootPart
            local distance = (hrp.Position - targetHrp.Position).Magnitude
            
            local priorityScore = 0
            if ragebotPriority == "Distance" then
                priorityScore = 1000 - distance
            elseif ragebotPriority == "Health" then
                local humanoid = player.Character:FindFirstChild("Humanoid")
                if humanoid then
                    priorityScore = humanoid.Health / humanoid.MaxHealth * 100
                end
            elseif ragebotPriority == "Visibility" then
                local screenPos, onScreen = Camera:WorldToScreenPoint(targetHrp.Position)
                if onScreen then
                    priorityScore = 100
                end
            end
            
            table.insert(targetTable, {
                player = player,
                hrp = targetHrp,
                distance = distance,
                priority = priorityScore
            })
        end
    end
    
    table.sort(targetTable, function(a, b)
        return a.priority > b.priority
    end)
    
    return targetTable
end

local function SmoothAim(currentPos, targetPos)
    return currentPos + (targetPos - currentPos) * ragebotSmoothness
end

local function FireRageShot(targetPos)
    local char, hrp = GetCharacter()
    if not char or not hrp then return end
    
    local remote = ReplicatedStorage:FindFirstChild("ShootEvent")
    if not remote then
        remote = ReplicatedStorage:FindFirstChild("Attack")
        if not remote then return end
    end
    
    local success, err = pcall(function()
        remote:FireServer(targetPos)
    end)
    if not success then
        warn("FireRageShot failed: " .. tostring(err))
        return
    end
    
    if ragebotHumanization then
        local randomOffset = Vector3.new(
            math.random(-5, 5) / 10,
            math.random(-5, 5) / 10,
            math.random(-5, 5) / 10
        )
        pcall(function()
            remote:FireServer(targetPos + randomOffset)
        end)
    end
end

local function Ragebot()
    if not ragebotEnabled then return end
    local char, hrp = GetCharacter()
    if not char or not hrp then return end
    
    local targets = GetRageTargets()
    if #targets == 0 then return end
    
    local bestTarget = nil
    local bestScore = -math.huge
    
    for _, target in ipairs(targets) do
        if target.distance <= ragebotFOV then
            local score = target.priority
            if math.random(1, 100) <= ragebotHitChance then
                score = score * 1.5
            end
            if score > bestScore then
                bestScore = score
                bestTarget = target
            end
        end
    end
    
    if bestTarget then
        local targetPos
        if ragebotPrediction then
            local velocity = bestTarget.hrp.Velocity
            targetPos = bestTarget.hrp.Position + (velocity * ragebotPredictionMultiplier)
        else
            targetPos = bestTarget.hrp.Position
        end
        
        -- スムーズネス適用
        local currentPos = hrp.Position
        local smoothPos = SmoothAim(currentPos, targetPos)
        FireRageShot(smoothPos)
        
        if ragebotWallbang then
            local remote = ReplicatedStorage:FindFirstChild("WallbangEvent")
            if remote then
                pcall(function()
                    remote:FireServer(bestTarget.player)
                end)
            end
        end
        
        if ragebotAutoShoot then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and bestTarget.distance < 100 then
                pcall(function()
                    tool:Activate()
                end)
            end
        end
        
        if ragebotTriggerbot then
            local screenPos, onScreen = Camera:WorldToScreenPoint(bestTarget.hrp.Position)
            if onScreen then
                local distance = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                if distance < 100 then
                    task.wait(ragebotTriggerDelay)
                    FireRageShot(bestTarget.hrp.Position)
                end
            end
        end
        
        if ragebotMultiTarget and #targets > 1 then
            for i = 2, math.min(3, #targets) do
                local target = targets[i]
                if target and target.hrp then
                    FireRageShot(target.hrp.Position + Vector3.new(math.random(-5, 5), math.random(-5, 5), math.random(-5, 5)))
                end
            end
        end
    end
end

