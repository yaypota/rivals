local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()

local Window = Library.CreateLib("Rivals Utility", "DarkTheme")
local MainTab = Window:NewTab("Main")
local MainSection = MainTab:NewSection("Main Features")
local PlayerTab = Window:NewTab("Player")
local PlayerSection = PlayerTab:NewSection("Player Settings")
local SettingTab = Window:NewTab("Settings")
local SettingSection = SettingTab:NewSection("Configuration")

local teleportEnabled = false
local enemyTeleportLoop = nil
local savedPosition = nil
local antiVoidEnabled = false
local antiVoidConnection = nil


MainSection:NewToggle("Enemy Teleport", "Teleports to the nearest enemy continuously", function(state)
    teleportEnabled = state
    local player = game.Players.LocalPlayer
    
    if teleportEnabled then
        enemyTeleportLoop = game:GetService("RunService").Heartbeat:Connect(function()
            if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
                return
            end
            
            local closestEnemy = nil
            local closestDistance = math.huge
            local myPosition = player.Character.HumanoidRootPart.Position
            
            for _, otherPlayer in ipairs(game.Players:GetPlayers()) do
                if otherPlayer ~= player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local enemyPosition = otherPlayer.Character.HumanoidRootPart.Position
                    local distance = (myPosition - enemyPosition).Magnitude
                    
                    if distance < closestDistance and distance < 100 then
                        closestEnemy = otherPlayer
                        closestDistance = distance
                    end
                end
            end
            
            if closestEnemy then
                local targetPosition = closestEnemy.Character.HumanoidRootPart.Position
                local teleportCFrame = CFrame.new(targetPosition + Vector3.new(0, 2, 0))
                player.Character.HumanoidRootPart.CFrame = teleportCFrame
            end
        end)
    else
        if enemyTeleportLoop then
            enemyTeleportLoop:Disconnect()
            enemyTeleportLoop = nil
        end
    end
end)


MainSection:NewButton("Save Position", "Saves current position for void teleport", function()
    local player = game.Players.LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        savedPosition = player.Character.HumanoidRootPart.CFrame
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Position Saved",
            Text = "Return position saved successfully!",
            Duration = 2
        })
    end
end)


MainSection:NewToggle("Anti-Void", "Teleports to saved position when falling into void", function(state)
    antiVoidEnabled = state
    local player = game.Players.LocalPlayer
    
    if antiVoidEnabled then
        if not savedPosition then
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = "Error",
                Text = "Please save a position first",
                Duration = 3
            })
            return
        end
        
        antiVoidConnection = game:GetService("RunService").Heartbeat:Connect(function()
            if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
                return
            end
            
            local humanoidRootPart = player.Character.HumanoidRootPart
            if humanoidRootPart.Position.Y < -50 then
                humanoidRootPart.CFrame = savedPosition
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "Void Detected",
                    Text = "Teleported to saved position",
                    Duration = 1
                })
            end
        end)
    else
        if antiVoidConnection then
            antiVoidConnection:Disconnect()
            antiVoidConnection = nil
        end
    end
end)


PlayerSection:NewSlider("Walk Speed", "Changes player's walk speed", 16, 100, 16, function(value)
    local player = game.Players.LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.WalkSpeed = value
    end
end)


PlayerSection:NewSlider("Jump Power", "Changes player's jump power", 50, 150, 50, function(value)
    local player = game.Players.LocalPlayer
    if player and player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.JumpPower = value
    end
end)


PlayerSection:NewLabel("Current Speed: " .. tostring(game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") and game.Players.LocalPlayer.Character.Humanoid.WalkSpeed or "Unknown"))
	
SettingSection:NewDropdown("Theme Color", "Changes UI theme color", {"Dark", "Light", "Blue", "Red"}, "Dark", function(value)
    print("Theme changed to: " .. value)
end)


SettingSection:NewButton("Reset Settings", "Resets all settings to default", function()
    print("Settings reset")
end)

Window.Show()
