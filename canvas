local teleportEnabled = false
local enemyTeleportLoop = nil

MainLeftGroup:AddToggle("PlayerTeleport", {
    Text = "Player Teleport",
    Description = "Teleports to the nearest enemy continuously",
    Default = false,
    Callback = function(state)
        teleportEnabled = state
        local player = game.Players.LocalPlayer
        
        if teleportEnabled then
            enemyTeleportLoop = game:GetService("RunService").Heartbeat:Connect(function()
                if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
                    return
                end
                
                local closestEnemy = nil
                local closestDistance = math.huge
                local myPosition = player.Character.HumanoidRootPart.Position
                
                for _, otherPlayer in ipairs(game.Players:GetPlayers()) do
                    if otherPlayer ~= player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local enemyPosition = otherPlayer.Character.HumanoidRootPart.Position
                        local distance = (myPosition - enemyPosition).Magnitude
                        
                        if distance < closestDistance and distance < 100 then
                            closestEnemy = otherPlayer
                            closestDistance = distance
                        end
                    end
                end
                
                if closestEnemy then
                    local targetPosition = closestEnemy.Character.HumanoidRootPart.Position
                    local teleportCFrame = CFrame.new(targetPosition + Vector3.new(0, 2, 0))
                    player.Character.HumanoidRootPart.CFrame = teleportCFrame
                end
            end)
        else
            if enemyTeleportLoop then
                enemyTeleportLoop:Disconnect()
                enemyTeleportLoop = nil
            end
        end
    end
})

local voidPosition = nil
local voidPositionConnection = nil

MainRightGroup:AddButton({
    Text = "Set Void Position",
    Description = "Saves current position for void teleport",
    Func = function()
        local player = game.Players.LocalPlayer
        if player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            voidPosition = player.Character.HumanoidRootPart.CFrame
        end
    end
})

MainRightGroup:AddToggle("Void Teleport", {
    Text = "Void Teleport",
    Description = "Teleports to saved position when falling into void",
    Default = false,
    Callback = function(state)
        local player = game.Players.LocalPlayer
        
        if state then
            if not voidPosition then
                return
            end
            
            voidPositionConnection = game:GetService("RunService").Heartbeat:Connect(function()
                if not player or not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
                    return
                end
                
                local humanoidRootPart = player.Character.HumanoidRootPart
                if humanoidRootPart.Position.Y < -50 then
                    humanoidRootPart.CFrame = voidPosition
                end
            end)
        else
            if voidPositionConnection then
                voidPositionConnection:Disconnect()
                voidPositionConnection = nil
            end
        end
    end
})

