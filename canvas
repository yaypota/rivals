local function GetCharacter()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil, nil end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return nil, nil, nil end
    return char, hrp, humanoid
end

local function UpdateProjectileCache()
    for i = #projectileCache, 1, -1 do
        table.remove(projectileCache, i)
    end
    local char, hrp = GetCharacter()
    if not char or not hrp then return end
    local playerPos = hrp.Position
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent and not obj.Parent:IsA("Player") then
            local isProjectile = false
            local name = obj.Name:lower()
            if name:find("projectile") or name:find("bullet") or name:find("missile") or 
               name:find("rocket") or name:find("ball") or name:find("orb") or
               name:find("shot") or name:find("beam") or name:find("laser") or name:find("void") then
                isProjectile = true
            end
            if not isProjectile and obj.Velocity and obj.Velocity.Magnitude > 10 then
                isProjectile = true
            end
            if isProjectile then
                local distance = (playerPos - obj.Position).Magnitude
                if distance < dodgeRadius then
                    table.insert(projectileCache, {
                        object = obj,
                        position = obj.Position,
                        velocity = obj.Velocity,
                        distance = distance
                    })
                end
            end
        end
    end
end

local function GetRageTargets()
    for i = #targetTable, 1, -1 do
        table.remove(targetTable, i)
    end
    local char, hrp = GetCharacter()
    if not char or not hrp then return targetTable end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local targetHrp = player.Character.HumanoidRootPart
            local distance = (hrp.Position - targetHrp.Position).Magnitude
            table.insert(targetTable, {
                player = player,
                hrp = targetHrp,
                distance = distance
            })
        end
    end
    table.sort(targetTable, function(a, b)
        return a.distance < b.distance
    end)
    return targetTable
end

local function FireRageShot(targetPos)
    local char, hrp = GetCharacter()
    if not char or not hrp then return end
    local remote = ReplicatedStorage:FindFirstChild("ShootEvent") or ReplicatedStorage:FindFirstChild("Attack")
    if not remote then return end
    pcall(function()
        remote:FireServer(targetPos)
    end)
    if ragebotHumanization then
        local randomOffset = Vector3.new(
            math.random(-5, 5) / 10,
            math.random(-5, 5) / 10,
            math.random(-5, 5) / 10
        )
        pcall(function()
            remote:FireServer(targetPos + randomOffset)
        end)
    end
end

local function Ragebot()
    if not ragebotEnabled then return end
    local char, hrp = GetCharacter()
    if not char or not hrp then return end
    local targets = GetRageTargets()
    if #targets == 0 then return end
    local bestTarget = nil
    local bestScore = -math.huge
    for _, target in ipairs(targets) do
        if target.distance <= ragebotFOV then
            local score = 1000 - target.distance
            if math.random(1, 100) <= ragebotHitChance then
                score = score * 1.5
            end
            if score > bestScore then
                bestScore = score
                bestTarget = target
            end
        end
    end
    if bestTarget then
        local targetPos
        if ragebotPrediction then
            local velocity = bestTarget.hrp.Velocity
            targetPos = bestTarget.hrp.Position + (velocity * ragebotPredictionMultiplier)
        else
            targetPos = bestTarget.hrp.Position
        end
        FireRageShot(targetPos)
        if ragebotWallbang then
            local remote = ReplicatedStorage:FindFirstChild("WallbangEvent")
            if remote then
                pcall(function()
                    remote:FireServer(bestTarget.player)
                end)
            end
        end
        if ragebotAutoShoot then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and bestTarget.distance < 100 then
                pcall(function()
                    tool:Activate()
                end)
            end
        end
        if ragebotTriggerbot then
            local screenPos, onScreen = Camera:WorldToScreenPoint(bestTarget.hrp.Position)
            if onScreen then
                local distance = (Vector2.new(Mouse.X, Mouse.Y) - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                if distance < 100 then
                    task.wait(ragebotTriggerDelay)
                    FireRageShot(bestTarget.hrp.Position)
                end
            end
        end
        if ragebotMultiTarget and #targets > 1 then
            for i = 2, math.min(3, #targets) do
                local target = targets[i]
                if target and target.hrp then
                    FireRageShot(target.hrp.Position + Vector3.new(math.random(-5, 5), math.random(-5, 5), math.random(-5, 5)))
                end
            end
        end
    end
end

local function DrawFOVCircle()
    if not ragebotFOVCircle then
        if fovCircle then
            fovCircle.Visible = false
        end
        return
    end
    if not fovCircle then
        fovCircle = Drawing.new("Circle")
        fovCircle.Thickness = 2
        fovCircle.Filled = false
        fovCircle.Transparency = 0.5
    end
    fovCircle.Radius = ragebotFOVSize / 2
    fovCircle.Color = ragebotFOVColor
    fovCircle.Visible = true
    fovCircle.Position = Vector2.new(Mouse.X, Mouse.Y)
end

local function PredictProjectile(projectile)
    if not projectile then return nil end
    local char, hrp = GetCharacter()
    if not char or not hrp then return nil end
    local playerPos = hrp.Position
    local projPos = projectile.position
    local projVel = projectile.velocity
    if projVel.Magnitude < 1 then return nil end
    local dirToPlayer = (playerPos - projPos).Unit
    local projDir = projVel.Unit
    local angle = math.acos(math.clamp(dirToPlayer:Dot(projDir), -1, 1))
    local relativeVelocity = projVel - Vector3.new(0, 0, 0)
    local timeToImpact = (playerPos - projPos).Magnitude / (relativeVelocity.Magnitude + 0.001)
    local isCritical = false
    if timeToImpact < 1 and angle < math.rad(45) then
        isCritical = true
    end
    return {
        timeToImpact = timeToImpact,
        isCritical = isCritical
    }
end

local function GetDodgeDirection(projectile)
    if dodgeDirection == "Random" then
        local angle = math.random(0, 360)
        local rad = math.rad(angle)
        return Vector3.new(math.cos(rad), 0, math.sin(rad)) * dodgeDistance
    elseif dodgeDirection == "Left" then
        return -Camera.CFrame.RightVector * dodgeDistance
    elseif dodgeDirection == "Right" then
        return Camera.CFrame.RightVector * dodgeDistance
    elseif dodgeDirection == "Back" then
        return -Camera.CFrame.LookVector * dodgeDistance
    elseif dodgeDirection == "Forward" then
        return Camera.CFrame.LookVector * dodgeDistance
    else
        local projDir = projectile.velocity.Unit
        local perpDir = Vector3.new(-projDir.Z, 0, projDir.X)
        if math.random(1, 2) == 1 then
            perpDir = -perpDir
        end
        return perpDir * dodgeDistance
    end
end

local function PerformDodge(direction)
    local char, hrp = GetCharacter()
    if not char or not hrp then return end
    if currentDodgeTween then
        currentDodgeTween:Cancel()
        currentDodgeTween = nil
    end
    local targetPos = hrp.Position + direction
    local tweenInfo = TweenInfo.new(
        dodgeSmoothness,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )
    pcall(function()
        currentDodgeTween = TweenService:Create(hrp, tweenInfo, {Position = targetPos})
        currentDodgeTween:Play()
        currentDodgeTween.Completed:Connect(function()
            currentDodgeTween = nil
        end)
    end)
    dodgeLastDodge = tick()
end

local function Dodger()
    if not dodgeEnabled then return end
    local char, hrp = GetCharacter()
    if not char or not hrp then return end
    if tick() - dodgeLastDodge < dodgeCooldown then
        return
    end
    if tick() - lastUpdate > 1 then
        UpdateProjectileCache()
        lastUpdate = tick()
    end
    if #projectileCache == 0 then return end
    local shouldDodge = false
    local dangerLevel = 0
    for _, proj in ipairs(projectileCache) do
        local prediction = PredictProjectile(proj)
        if prediction then
            if prediction.isCritical then
                dangerLevel = dangerLevel + 2
            else
                dangerLevel = dangerLevel + 1
            end
            if dodgeMode == "Auto" then
                shouldDodge = true
            elseif dodgeMode == "Smart" then
                if prediction.timeToImpact < 0.5 or prediction.isCritical then
                    shouldDodge = true
                end
            elseif dodgeMode == "Manual" then
                if UserInputService:IsKeyDown(Enum.KeyCode.X) then
                    shouldDodge = true
                end
            end
            if shouldDodge then
                local dir = GetDodgeDirection(proj)
                if dir then
                    PerformDodge(dir)
                    return
                end
            end
        end
    end
    if dodgeOnlyCritical and dangerLevel < 2 then
        return
    end
end

local function GetRandomTarget(targets)
    if #targets == 0 then return nil end
    return targets[math.random(1, #targets)]
end

local function CastVoidSpell(target)
    if not target or not target.Character then return end
    local char, hrp = GetCharacter()
    if not char or not hrp then return end
    local remote = ReplicatedStorage:FindFirstChild("VoidSpellEvent") or ReplicatedStorage:FindFirstChild("CastSpell")
    if not remote then return end
    local targetPos = target.Character.HumanoidRootPart.Position
    pcall(function()
        remote:FireServer(targetPos, target)
    end)
    if voidSpamCooldownReduction then
        local cooldownRemote = ReplicatedStorage:FindFirstChild("CooldownReduction")
        if cooldownRemote then
            pcall(function()
                cooldownRemote:FireServer()
            end)
        end
    end
    if voidSpamEnergyBoost then
        local energyRemote = ReplicatedStorage:FindFirstChild("EnergyBoost")
        if energyRemote then
            pcall(function()
                energyRemote:FireServer()
            end)
        end
    end
end

local function VoidSpam()
    if not voidSpamEnabled then return end
    local char, hrp = GetCharacter()
    if not char or not hrp then return end
    local targets = {}
    if voidSpamAutoTarget or voidSpamTargetAll then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local distance = (hrp.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if distance <= voidSpamRange then
                    table.insert(targets, player)
                end
            end
        end
    end
    if voidSpamAOE then
        local remote = ReplicatedStorage:FindFirstChild("VoidAOEEvent")
        if remote then
            local centerPos = hrp.Position
            for _, target in ipairs(targets) do
                if target.Character then
                    local targetPos = target.Character.HumanoidRootPart.Position
                    if (centerPos - targetPos).Magnitude <= voidSpamAOERadius then
                        pcall(function()
                            remote:FireServer(targetPos, target, voidSpamAOERadius)
                        end)
                    end
                end
            end
        end
    end
    if voidSpamMultiCast then
        for i = 1, voidSpamCastCount do
            if voidSpamTargetAll then
                for _, target in ipairs(targets) do
                    CastVoidSpell(target)
                    if voidSpamRandomize then
                        task.wait(math.random(1, 10) / 100)
                    end
                end
            else
                local target = GetRandomTarget(targets)
                if target then
                    CastVoidSpell(target)
                end
            end
        end
    else
        if voidSpamTargetAll then
            for _, target in ipairs(targets) do
                CastVoidSpell(target)
            end
        else
            local target = GetRandomTarget(targets)
            if target then
                CastVoidSpell(target)
            end
        end
    end
    if voidSpamSilentCast then
        local remote = ReplicatedStorage:FindFirstChild("SilentCastEvent")
        if remote then
            for _, target in ipairs(targets) do
                if target.Character then
                    pcall(function()
                        remote:FireServer(target)
                    end)
                end
            end
        end
    end
end

