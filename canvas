        if SaveManager then
            pcall(function()
                SaveManager:Save()
            end)
        end
    end
})

SettingsGroup:AddButton("Load Config", {
    Func = function()
        if SaveManager then
            pcall(function()
                SaveManager:Load()
            end)
        end
    end
})

SettingsGroup:AddButton("Reset Config", {
    Func = function()
        if SaveManager then
            pcall(function()
                SaveManager:Reset()
            end)
        end
    end
})

SettingsRightGroup:AddDropdown("UI Theme", {
    Default = 1,
    Options = {"Default", "Dark", "Light", "Neon", "Pastel", "Cyberpunk"},
    Callback = function(value)
        if ThemeManager then
            pcall(function()
                ThemeManager:SetTheme(value)
            end)
        end
    end
})

SettingsRightGroup:AddButton("Reset Theme", {
    Func = function()
        if ThemeManager then
            pcall(function()
                ThemeManager:SetTheme("Default")
            end)
        end
    end
})

if SaveManager then
    SaveManager:SetLibrary(Library)
    SaveManager:IgnoreThemeSettings()
    SaveManager:SetIgnoreIndexes({})
    SaveManager:SetFolder("CanvasLeft/saves")
end

if ThemeManager then
    ThemeManager:SetLibrary(Library)
    ThemeManager:SetFolder("CanvasLeft/themes")
end

Library:OnUnload(function()
    voidSpamEnabled = false
    if voidSpamConnection then
        voidSpamConnection:Disconnect()
        voidSpamConnection = nil
    end
    if characterAddedConnection then
        characterAddedConnection:Disconnect()
        characterAddedConnection = nil
    end
    if currentDodgeTween then
        currentDodgeTween:Cancel()
        currentDodgeTween = nil
    end
    if fovCircle then
        fovCircle:Remove()
        fovCircle = nil
    end
end)

pcall(function()
    if SaveManager then SaveManager:Load() end
    if ThemeManager then ThemeManager:Load() end
end)

Library:SetWatermarkVisibility(true)
Library:SetWatermark("Canvas - Left")

characterAddedConnection = LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    local character, hrp, humanoid = GetCharacter()
    if character and humanoid then
        if flyEnabled then
            humanoid.PlatformStand = true
        end
        if noclipEnabled then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
        if speedEnabled then
            humanoid.WalkSpeed = walkSpeed
        end
        if infiniteJumpEnabled then
            humanoid.JumpPower = jumpPower
        end
    end
    UpdateProjectileCache()
end)

RunService.RenderStepped:Connect(function()
    pcall(function()
        if ragebotEnabled then
            Ragebot()
        end
        if dodgeEnabled then
            Dodger()
        end
        if ragebotFOVCircle then
            DrawFOVCircle()
        elseif fovCircle then
            fovCircle.Visible = false
        end
        local char, hrp, humanoid = GetCharacter()
        if char and humanoid then
            healthLabel:SetText("Health: " .. math.floor(humanoid.Health))
            maxHealthLabel:SetText("Max Health: " .. math.floor(humanoid.MaxHealth))
        end
        if hrp then
            local pos = hrp.Position
            positionLabel:SetText("Position: " .. string.format("%.1f, %.1f, %.1f", pos.X, pos.Y, pos.Z))
        end
        if flyEnabled and hrp then
            local moveDirection = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDirection = moveDirection + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDirection = moveDirection - Vector3.new(0, 1, 0) end
            if moveDirection.Magnitude > 0 then
                moveDirection = moveDirection.Unit * flySpeed
                hrp.Velocity = moveDirection
            else
                hrp.Velocity = Vector3.new(0, 0, 0)
            end
        end
    end)
end)
